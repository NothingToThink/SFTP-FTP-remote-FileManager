  "components": {
    "schemas": {
      "HostProfile": {
        "type": "object",
        "required": [
          "host",
          "protocol",
          "auth"
        ],
        "properties": {
          "host": {
            "type": "string",
            "example": "example.com"
          },
          "protocol": {
            "$ref": "#/components/schemas/Protocol"
          },
          "port": {
            "type": "integer",
            "nullable": true,
            "example": 22
          },
          "auth": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PasswordAuth"
              },
              {
                "$ref": "#/components/schemas/KeyAuth"
              },
              {
                "$ref": "#/components/schemas/AnonymousAuth"
              }
            ]
          }
        }
      },
      "Protocol": {
        "type": "string",
        "enum": [
          "Local",
          "Ftp",
          "Sftp"
        ]
      },
      "PasswordAuth": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "KeyAuth": {
        "type": "object",
        "required": [
          "username",
          "keyPath"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "keyPath": {
            "type": "string"
          },
          "passphrase": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AnonymousAuth": {
        "type": "object",
        "properties": {}
      },
      "ConnectionState": {
        "type": "object",
        "properties": {
          "isConnected": {
            "type": "boolean"
          }
        }
      },
      "OperationStatus": {
        "type": "object",
        "required": [
          "code",
          "message",
          "isSuccess"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "files received"
          },
          "isSuccess": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "FileItem": {
        "type": "object",
        "required": [
          "name",
          "size",
          "lastModified",
          "isDirectory",
          "fullPath",
          "permissions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "report.txt"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "example": 1024
          },
          "lastModified": {
            "type": "string",
            "format": "date-time"
          },
          "isDirectory": {
            "type": "boolean",
            "example": false
          },
          "fullPath": {
            "type": "string",
            "example": "/docs/report.txt"
          },
          "permissions": {
            "type": "string",
            "example": "rw-r--r--"
          }
        }
      },
      "FileListResult": {
        "type": "object",
        "required": [
          "data",
          "status",
          "isSuccess"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileItem"
            }
          },
          "status": {
            "$ref": "#/components/schemas/OperationStatus"
          },
          "isSuccess": {
            "type": "boolean"
          }
        }
      },
      "FileItemResult": {
        "type": "object",
        "required": [
          "data",
          "status",
          "isSuccess"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/FileItem",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/OperationStatus"
          },
          "isSuccess": {
            "type": "boolean"
          }
        }
      },
      "ExistsResult": {
        "type": "object",
        "required": [
          "path",
          "exists"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "exists": {
            "type": "boolean"
          }
        }
      },
      "PathRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "example": "/docs/new-folder"
          }
        }
      },
      "PathsRequest": {
        "type": "object",
        "required": [
          "paths"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RenameRequest": {
        "type": "object",
        "required": [
          "oldPath",
          "newPath"
        ],
        "properties": {
          "oldPath": {
            "type": "string"
          },
          "newPath": {
            "type": "string"
          }
        }
      },
      "CopyMoveRequest": {
        "type": "object",
        "required": [
          "sourcePaths",
          "targetPath"
        ],
        "properties": {
          "sourcePaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targetPath": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "UploadRequest": {
        "type": "object",
        "required": [
          "remotePath",
          "file"
        ],
        "properties": {
          "remotePath": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "format": "binary"
          },
          "overwrite": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "DownloadRequest": {
        "type": "object",
        "required": [
          "remotePath"
        ],
        "properties": {
          "remotePath": {
            "type": "string"
          }
        }
      },
      "BulkOperationStatus": {
        "type": "object",
        "required": [
          "isSuccess",
          "completed",
          "failed",
          "items"
        ],
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "completed": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkOperationItem"
            }
          }
        }
      },
      "BulkOperationItem": {
        "type": "object",
        "properties": {
          "sourcePath": {
            "type": "string"
          },
          "targetPath": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/OperationStatus"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 1
          },
          "message": {
            "type": "string"
          },
          "isSuccess": {
            "type": "boolean",
            "example": false
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "???????? ??????",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "?? ???????",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AlreadyExists": {
        "description": "??? ??????????",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
