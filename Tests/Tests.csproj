<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Backend\Backend.csproj" />
  </ItemGroup>

  <!-- Plugins for the host tests: built before the tests and published next to them (testplugins/<name>). -->
  <ItemGroup>
    <TestPlugin Include="..\plugins\Sample.Echo\Sample.Echo.csproj" PublishName="Sample.Echo" />
    <TestPlugin Include="..\Tests.Plugins\DepPlugin\DepPlugin.csproj" PublishName="DepPlugin" />
    <ProjectReference Include="@(TestPlugin)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The agent plugin is also referenced for real: the scenario tests use its classes with fake dependencies. -->
  <ItemGroup>
    <ProjectReference Include="..\plugins\VolcanoBoys.Agent\VolcanoBoys.Agent.csproj" />
  </ItemGroup>

  <Target Name="PublishTestPlugins" AfterTargets="Build">
    <MSBuild Projects="%(TestPlugin.FullPath)" Targets="Publish"
             Properties="NoBuild=true;PublishDir=$(MSBuildProjectDirectory)/$(OutDir)testplugins\%(TestPlugin.PublishName)\" />
    <MSBuild Projects="..\plugins\VolcanoBoys.Agent\VolcanoBoys.Agent.csproj" Targets="Publish"
             Properties="NoBuild=true;PublishDir=$(MSBuildProjectDirectory)/$(OutDir)testplugins\VolcanoBoys.Agent\" />
  </Target>

</Project>
