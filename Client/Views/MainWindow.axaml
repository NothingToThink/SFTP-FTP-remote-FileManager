<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileManagerClient.Converters"
        x:Class="FileManagerClient.Views.MainWindow"
        Title="Файловый менеджер — SFTP/FTP"
        Width="1180" Height="740"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ServerStatusToBrushConverter x:Key="StatusBrush"/>
    </Window.Resources>

    <DockPanel>
        <!-- Статус-бар: состояние сервера + настройки (шестерёнка) -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                         Fill="{Binding ServerStatus, Converter={StaticResource StatusBrush}}"/>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="120" HorizontalAlignment="Right"
                             IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Настройки сервера"
                        Command="{Binding OpenServerSettingsCommand}">
                    <PathIcon Data="{StaticResource IconSettings}" Width="15" Height="15"/>
                </Button>
            </Grid>
        </Border>

        <!-- Профили -->
        <Border DockPanel.Dock="Left" Width="280" Background="{StaticResource BgPanelBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,10">
                    <TextBlock Grid.Column="0" Classes="secondary" FontWeight="Medium"
                               Text="Подключения" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Новый профиль"
                            Command="{Binding AddProfileCommand}">
                        <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Classes="primary" Content="Подключить" Command="{Binding ConnectProfileCommand}"
                            CommandParameter="{Binding SelectedProfile}"/>
                    <Button Classes="icon" ToolTip.Tip="Отключить профиль" Command="{Binding DisconnectProfileCommand}"
                            CommandParameter="{Binding SelectedProfile}">
                        <PathIcon Data="{StaticResource IconDisconnect}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="icon" ToolTip.Tip="Изменить профиль" Command="{Binding EditProfileCommand}">
                        <PathIcon Data="{StaticResource IconPencil}" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="icon danger" ToolTip.Tip="Удалить профиль" Command="{Binding DeleteProfileCommand}">
                        <PathIcon Data="{StaticResource IconTrash}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                         DoubleTapped="ProfilesListDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,2" Spacing="3">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource SuccessBrush}" IsVisible="{Binding IsConnected}"/>
                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource BorderStrongBrush}" IsVisible="{Binding !IsConnected}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Classes="mono muted" FontSize="11" Margin="14,0,0,0"
                                           Text="{Binding DisplayHost}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Рабочая область -->
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Стрип активного подключения -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="2,0,2,10"
                  IsVisible="{Binding Browser.IsBound}">
                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Grid.Column="1" Classes="h1" FontSize="14.5"
                           Text="{Binding Browser.ConnectionName}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Classes="mono secondary" FontSize="12" Margin="12,1,12,0"
                           Text="{Binding Browser.CurrentPath}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Classes="muted" VerticalAlignment="Center"
                           Text="{Binding Browser.ItemCount, StringFormat='{}{0} объектов'}"/>
            </Grid>
            <TextBlock Grid.Row="0" Classes="muted" Margin="2,0,2,10" IsVisible="{Binding !Browser.IsBound}"
                       Text="Подключение не выбрано"/>

            <!-- Строка пути и строка действий разнесены: на узких окнах кнопки не толпятся -->
            <StackPanel Grid.Row="1" DataContext="{Binding Browser}" Spacing="8" Margin="2,0,2,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="icon" ToolTip.Tip="На уровень выше" Command="{Binding GoUpCommand}"
                            IsEnabled="{Binding IsBound}">
                        <PathIcon Data="{StaticResource IconUp}" Width="14" Height="14"/>
                    </Button>
                    <TextBox Width="360" Text="{Binding CurrentPath}" FontFamily="{StaticResource FontMono}"
                             Watermark="Путь" KeyDown="PathBoxKeyDown" IsReadOnly="{Binding !IsBound}"/>
                    <Button Classes="tool" Content="Перейти" Command="{Binding NavigateCommand}"
                            CommandParameter="{Binding CurrentPath}" IsEnabled="{Binding IsBound}"/>
                    <Button Classes="icon" ToolTip.Tip="Обновить" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsBound}">
                        <PathIcon Data="{StaticResource IconSync}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="tool" ToolTip.Tip="Новый файл" Command="{Binding NewFileCommand}"
                            IsEnabled="{Binding IsBound}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11"/>
                            <TextBlock Text="Файл"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" ToolTip.Tip="Новая папка" Command="{Binding NewFolderCommand}"
                            IsEnabled="{Binding IsBound}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14"/>
                            <TextBlock Text="Папка"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" ToolTip.Tip="Загрузить файл на сервер" Command="{Binding UploadCommand}"
                            IsEnabled="{Binding IsBound}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconUpload}" Width="13" Height="13"/>
                            <TextBlock Text="Загрузить"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" ToolTip.Tip="Скачать выбранный файл" Command="{Binding DownloadCommand}"
                            IsEnabled="{Binding IsBound}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{StaticResource IconDownload}" Width="13" Height="13"/>
                            <TextBlock Text="Скачать"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Список файлов + зона drop для загрузки -->
            <Grid Grid.Row="2" x:Name="DropArea" DragDrop.AllowDrop="True">
                <DataGrid ItemsSource="{Binding Browser.Items}"
                          SelectedItem="{Binding Browser.SelectedItem}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          IsVisible="{Binding Browser.IsBound}"
                          DoubleTapped="FilesGridDoubleTapped">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть" Command="{Binding Browser.OpenItemCommand}"/>
                        <MenuItem Header="Переименовать…" Command="{Binding Browser.RenameCommand}"/>
                        <MenuItem Header="Копировать в…" Command="{Binding Browser.CopyToCommand}"/>
                        <MenuItem Header="Переместить в…" Command="{Binding Browser.MoveToCommand}"/>
                        <MenuItem Header="Скачать…" Command="{Binding Browser.DownloadCommand}"/>
                        <MenuItem Header="Свойства" Command="{Binding Browser.ShowInfoCommand}"/>
                        <Separator/>
                        <MenuItem Header="Удалить" Command="{Binding Browser.DeleteCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Имя" SortMemberPath="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" Width="15" Height="15"
                                              Margin="0,0,9,0"
                                              Foreground="{StaticResource AccentBrush}"
                                              IsVisible="{Binding IsDirectory}"/>
                                    <PathIcon Grid.Column="0" Data="{StaticResource IconDoc}" Width="14" Height="14"
                                              Margin="0,0,10,0"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              IsVisible="{Binding !IsDirectory}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeDisplay}" Width="100"
                                        FontFamily="{StaticResource FontMono}" FontSize="12"/>
                    <DataGridTextColumn Header="Изменён"
                                        Binding="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm'}"
                                        Width="160" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                    <DataGridTextColumn Header="Права" Binding="{Binding Permissions}" Width="120"
                                        FontFamily="{StaticResource FontMono}" FontSize="12"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Пустое состояние: приглашение к действию -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" IsVisible="{Binding !Browser.IsBound}">
                    <PathIcon Data="{StaticResource IconFolderBig}" Width="44" Height="44"
                              Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Classes="h1" HorizontalAlignment="Center" Text="Нет активного подключения"/>
                    <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Выберите профиль слева и нажмите «Подключить»,&#10;либо создайте новый профиль со знаком «+»"/>
                </StackPanel>

                <!-- Оверлей при перетаскивании файлов -->
                <Border x:Name="DropOverlay" IsVisible="False"
                        Background="#B314161B" Margin="4" CornerRadius="10"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <PathIcon Data="{StaticResource IconUpload}" Width="38" Height="38"
                                  Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Classes="h1" HorizontalAlignment="Center" Text="Отпустите файлы"/>
                        <TextBlock Classes="secondary" HorizontalAlignment="Center"
                                   Text="Загрузятся в текущую папку"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
