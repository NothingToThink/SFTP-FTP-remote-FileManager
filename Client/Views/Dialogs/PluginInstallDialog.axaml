<dlg:DialogWindowBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:FileManagerClient.Views.Dialogs"
        xmlns:ctl="using:FileManagerClient.Controls"
        x:Class="FileManagerClient.Views.Dialogs.PluginInstallDialog"
        Title="Установка плагина">
    <Border Classes="dialog" Margin="20" Width="480"
            BoxShadow="0 8 32 0 #40000000">
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <ctl:PigIcon Kind="Snout" Size="44" Foreground="{DynamicResource Brush.Accent}"
                             VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText" Classes="h2" TextWrapping="Wrap" VerticalAlignment="Center"
                           MaxWidth="360" AutomationProperties.AutomationId="PluginInstallTitle"/>
            </StackPanel>
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="15"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       AutomationProperties.AutomationId="PluginInstallText"/>
            <TextBlock x:Name="MetaText" Classes="mono" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextFaint}"/>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</dlg:DialogWindowBase>
