<dlg:DialogWindowBase xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dlg="clr-namespace:FileManagerClient.Views.Dialogs"
        x:Class="FileManagerClient.Views.Dialogs.ConfirmDialog"
        Title="Подтверждение">
    <Border Classes="dialog" Margin="20" Width="460"
            BoxShadow="0 8 32 0 #40000000">
        <StackPanel Spacing="12">
            <TextBlock x:Name="TitleText" Classes="h2" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ConfirmTitle"/>
            <TextBlock x:Name="BodyText" TextWrapping="Wrap" FontSize="15"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       AutomationProperties.AutomationId="ConfirmText"/>
            <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                        Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</dlg:DialogWindowBase>
