<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileManagerClient.Converters"
        x:Class="FileManagerClient.Views.ProfileEditWindow"
        Title="Профиль подключения"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBaseBrush}">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="AuthIs"/>
    </Window.Resources>

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Classes="h1" Text="Профиль подключения"/>

        <TextBlock Classes="secondary" Text="Название" Margin="0,6,0,-4"/>
        <TextBox Text="{Binding Name}" Watermark="Мой сервер"/>

        <TextBlock Classes="secondary" Text="Протокол" Margin="0,8,0,-4"/>
        <ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}"
                  HorizontalAlignment="Left" MinWidth="220"/>

        <Panel IsVisible="{Binding !IsLocal}">
            <StackPanel Spacing="10">
                <TextBlock Classes="secondary" Text="Хост" Margin="0,8,0,-4"/>
                <TextBox Text="{Binding Host}" Watermark="host или IP" FontFamily="{StaticResource FontMono}"/>
                <TextBlock Classes="secondary" Text="Порт (пусто — стандартный для протокола)" Margin="0,4,0,-4"/>
                <TextBox Text="{Binding Port}" Watermark="22 / 21" FontFamily="{StaticResource FontMono}"/>
            </StackPanel>
        </Panel>

        <Panel IsVisible="{Binding NeedsAuth}">
            <StackPanel Spacing="10">
                <TextBlock Classes="secondary" Text="Авторизация" Margin="0,10,0,-4"/>
                <ComboBox ItemsSource="{Binding AuthKinds}" SelectedItem="{Binding AuthKind}"
                          HorizontalAlignment="Left" MinWidth="220"/>
                <TextBlock Classes="secondary" Text="Логин" Margin="0,4,0,-4"/>
                <TextBox Text="{Binding Username}" FontFamily="{StaticResource FontMono}"/>

                <Panel IsVisible="{Binding AuthKind, Converter={StaticResource AuthIs}, ConverterParameter=Password}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="secondary" Text="Пароль" Margin="0,4,0,-4"/>
                        <TextBox Text="{Binding Password}" PasswordChar="•"/>
                    </StackPanel>
                </Panel>

                <Panel IsVisible="{Binding AuthKind, Converter={StaticResource AuthIs}, ConverterParameter=Key}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="secondary" Text="Путь к приватному ключу" Margin="0,4,0,-4"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding KeyPath}" Width="350" FontFamily="{StaticResource FontMono}"
                                     Watermark="~/.ssh/id_rsa"/>
                            <Button Classes="tool" Content="…" ToolTip.Tip="Выбрать файл ключа" Click="BrowseKeyClick"/>
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="Пароль ключа (если установлен)" Margin="0,4,0,-4"/>
                        <TextBox Text="{Binding Passphrase}" PasswordChar="•"/>
                    </StackPanel>
                </Panel>
            </StackPanel>
        </Panel>

        <Border Background="#2A1715" CornerRadius="6" Padding="10,7" Margin="0,6,0,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#F09089" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Classes="tool" Content="Отмена" Width="104" IsCancel="True"/>
            <Button Classes="primary" Content="Сохранить" Width="104" Click="OkClick" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
