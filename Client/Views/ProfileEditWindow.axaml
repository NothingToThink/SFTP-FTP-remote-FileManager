<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileManagerClient.ViewModels;assembly=FileManagerClient"
        xmlns:conv="clr-namespace:FileManagerClient.Converters"
        x:Class="FileManagerClient.Views.ProfileEditWindow"
        x:DataType="vm:ProfileEditViewModel"
        Title="Профиль подключения"
        Width="520" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBaseBrush}">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="AuthIs"/>
        <conv:EnumLabelConverter x:Key="EnumLabel"/>
        <!-- Тона Expander: заголовок приподнят (тон BgElevatedBrush #22262E), тело чуть ниже (BgPanelBrush #1A1D24) -->
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#22262E"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#2A2F39"/>
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#1E2229"/>
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="#1A1D24"/>
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#2A2F39"/>
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#2A2F39"/>
    </Window.Resources>

    <StackPanel Margin="20" Spacing="10">
        <TextBlock Classes="h1" Text="Профиль подключения"/>

        <TextBlock Classes="secondary" Text="Название" Margin="0,6,0,-4"/>
        <TextBox Name="NameBox" AutomationProperties.AutomationId="ProfileNameBox"
                 Text="{Binding Name}" PlaceholderText="Мой сервер"/>

        <TextBlock Classes="secondary" Text="Протокол" Margin="0,8,0,-4"/>
        <ComboBox Name="ProtocolCombo" AutomationProperties.AutomationId="ProfileProtocolCombo"
                  ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Секция сворачивается (issue #41): шапку диалога держим компактной -->
        <Expander Name="ConnectionSection" AutomationProperties.AutomationId="ProfileConnectionExpander"
                  Header="Подключение" IsExpanded="True" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  IsVisible="{Binding !IsLocal}" Margin="0,10,0,0">
            <StackPanel Spacing="10" Margin="2,8,2,2" HorizontalAlignment="Stretch">
                <TextBlock Classes="secondary" Text="Хост"/>
                <TextBox Name="HostBox" AutomationProperties.AutomationId="ProfileHostBox"
                         Text="{Binding Host}" PlaceholderText="host или IP" FontFamily="{StaticResource FontMono}"/>
                <TextBlock Classes="secondary" Text="Порт (пусто — стандартный для протокола)"/>
                <TextBox Name="PortBox" AutomationProperties.AutomationId="ProfilePortBox"
                         Text="{Binding Port}" PlaceholderText="22 / 21" FontFamily="{StaticResource FontMono}"/>
            </StackPanel>
        </Expander>

        <Expander Name="AuthSection" AutomationProperties.AutomationId="ProfileAuthExpander"
                  Header="Авторизация" IsExpanded="True" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  IsVisible="{Binding NeedsAuth}" Margin="0,6,0,0">
            <StackPanel Spacing="10" Margin="2,8,2,2" HorizontalAlignment="Stretch">
                <ComboBox Name="AuthKindCombo" AutomationProperties.AutomationId="ProfileAuthKindCombo"
                          ItemsSource="{Binding AuthKinds}" SelectedItem="{Binding AuthKind}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="secondary" Text="Логин"/>
                <TextBox Name="UsernameBox" AutomationProperties.AutomationId="ProfileUsernameBox"
                         Text="{Binding Username}" FontFamily="{StaticResource FontMono}"/>

                <Panel IsVisible="{Binding AuthKind, Converter={StaticResource AuthIs}, ConverterParameter=Password}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="secondary" Text="Пароль"/>
                        <TextBox Name="PasswordBox" AutomationProperties.AutomationId="ProfilePasswordBox"
                                 Text="{Binding Password}" PasswordChar="•"/>
                    </StackPanel>
                </Panel>

                <Panel IsVisible="{Binding AuthKind, Converter={StaticResource AuthIs}, ConverterParameter=Key}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="secondary" Text="Путь к приватному ключу"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Name="KeyPathBox" AutomationProperties.AutomationId="ProfileKeyPathBox"
                                     Text="{Binding KeyPath}" MinWidth="120" FontFamily="{StaticResource FontMono}"
                                     PlaceholderText="~/.ssh/id_rsa"/>
                            <Button Name="BrowseKeyButton" Classes="tool" Content="…"
                                    AutomationProperties.AutomationId="ProfileKeyBrowseButton"
                                    ToolTip.Tip="Выбрать файл ключа" Click="BrowseKeyClick"/>
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="Пароль ключа (если установлен)"/>
                        <TextBox Name="PassphraseBox" AutomationProperties.AutomationId="ProfilePassphraseBox"
                                 Text="{Binding Passphrase}" PasswordChar="•"/>
                    </StackPanel>
                </Panel>
            </StackPanel>
        </Expander>

        <Border Background="#2A1715" CornerRadius="6" Padding="10,7" Margin="0,6,0,0"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Name="ErrorText" AutomationProperties.AutomationId="ProfileErrorText"
                       Text="{Binding ErrorMessage}" Foreground="#F09089" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="CancelButton" Classes="tool" Content="Отмена" Width="104"
                    AutomationProperties.AutomationId="ProfileCancelButton"
                    IsCancel="True" Click="CancelClick"/>
            <Button Name="OkButton" Classes="primary" Content="Сохранить" Width="104"
                    AutomationProperties.AutomationId="ProfileOkButton"
                    Click="OkClick" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
