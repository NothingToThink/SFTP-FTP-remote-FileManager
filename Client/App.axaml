<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileManagerClient.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FileManagerClient/Assets/Pig/PigIcons.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                <!-- Токены спеки -->
                <SolidColorBrush x:Key="Brush.Bg" Color="#FFF6F7"/>
                <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FDEBEF"/>
                <SolidColorBrush x:Key="Brush.Border" Color="#F2D9DE"/>
                <SolidColorBrush x:Key="Brush.Text" Color="#3A1420"/>
                <SolidColorBrush x:Key="Brush.TextMuted" Color="#6B4A52"/>
                <SolidColorBrush x:Key="Brush.Accent" Color="#C2566F"/>
                <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="Brush.AccentStrong" Color="#7A2338"/>
                <SolidColorBrush x:Key="Brush.Brand" Color="#F7A8B8"/>
                <SolidColorBrush x:Key="Brush.Error" Color="#C2410C"/>
                <SolidColorBrush x:Key="Brush.Warning" Color="#B45309"/>
                <SolidColorBrush x:Key="Brush.Success" Color="#15803D"/>
                <!-- Производные -->
                <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="Brush.BorderStrong" Color="#E3BFC7"/>
                <SolidColorBrush x:Key="Brush.TextFaint" Color="#8C6A73"/>
                <SolidColorBrush x:Key="Brush.AccentHover" Color="#B04A63"/>
                <SolidColorBrush x:Key="Brush.RowHover" Color="#FEF3F5"/>
                <SolidColorBrush x:Key="Brush.Scrim" Color="#D9FFF6F7"/>
                <SolidColorBrush x:Key="Brush.ErrorSoft" Color="#FDEDE3"/>
                <!-- Алиасы старых ключей (те же значения, что у токенов) -->
                <SolidColorBrush x:Key="BgBaseBrush" Color="#FFF6F7"/>
                <SolidColorBrush x:Key="BgPanelBrush" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="BgElevatedBrush" Color="#FDEBEF"/>
                <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="BorderSubtleBrush" Color="#F2D9DE"/>
                <SolidColorBrush x:Key="BorderStrongBrush" Color="#E3BFC7"/>
                <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3A1420"/>
                <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B4A52"/>
                <SolidColorBrush x:Key="TextMutedBrush" Color="#8C6A73"/>
                <SolidColorBrush x:Key="AccentBrush" Color="#C2566F"/>
                <SolidColorBrush x:Key="AccentHoverBrush" Color="#B04A63"/>
                <SolidColorBrush x:Key="AccentPressBrush" Color="#7A2338"/>
                <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
                <SolidColorBrush x:Key="SuccessBrush" Color="#15803D"/>
                <SolidColorBrush x:Key="DangerBrush" Color="#C2410C"/>
                <SolidColorBrush x:Key="RowHoverBrush" Color="#FEF3F5"/>
                <SolidColorBrush x:Key="RowSelectedBrush" Color="#FDEBEF"/>
                <!-- Свинка: цвета иллюстраций. Line/Detail — линии поверх фона (в тёмной теме светлые) -->
                <SolidColorBrush x:Key="Pig.Ink" Color="#3A1420"/>
                <SolidColorBrush x:Key="Pig.Body" Color="#F7A8B8"/>
                <SolidColorBrush x:Key="Pig.BodyShade" Color="#F08AA0"/>
                <SolidColorBrush x:Key="Pig.Slot" Color="#7A2338"/>
                <SolidColorBrush x:Key="Pig.Cork" Color="#C8925A"/>
                <SolidColorBrush x:Key="Pig.Line" Color="#3A1420"/>
                <SolidColorBrush x:Key="Pig.Detail" Color="#7A2338"/>
                <!-- Акцент Fluent: фокус, выделение -->
                <Color x:Key="SystemAccentColor">#C2566F</Color>
                <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#C2566F"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                <!-- Токены спеки -->
                <SolidColorBrush x:Key="Brush.Bg" Color="#1E0E13"/>
                <SolidColorBrush x:Key="Brush.Surface" Color="#2A1218"/>
                <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#3A1A22"/>
                <SolidColorBrush x:Key="Brush.Border" Color="#4A2530"/>
                <SolidColorBrush x:Key="Brush.Text" Color="#F7E9EC"/>
                <SolidColorBrush x:Key="Brush.TextMuted" Color="#C9A6AF"/>
                <SolidColorBrush x:Key="Brush.Accent" Color="#F08AA0"/>
                <SolidColorBrush x:Key="Brush.OnAccent" Color="#2A1218"/>
                <SolidColorBrush x:Key="Brush.AccentStrong" Color="#F7A8B8"/>
                <SolidColorBrush x:Key="Brush.Brand" Color="#F08AA0"/>
                <SolidColorBrush x:Key="Brush.Error" Color="#FB923C"/>
                <SolidColorBrush x:Key="Brush.Warning" Color="#FBBF24"/>
                <SolidColorBrush x:Key="Brush.Success" Color="#4ADE80"/>
                <!-- Производные -->
                <SolidColorBrush x:Key="Brush.Input" Color="#231015"/>
                <SolidColorBrush x:Key="Brush.BorderStrong" Color="#6A3644"/>
                <SolidColorBrush x:Key="Brush.TextFaint" Color="#9C7B85"/>
                <SolidColorBrush x:Key="Brush.AccentHover" Color="#F59DB0"/>
                <SolidColorBrush x:Key="Brush.RowHover" Color="#33161D"/>
                <SolidColorBrush x:Key="Brush.Scrim" Color="#D91E0E13"/>
                <SolidColorBrush x:Key="Brush.ErrorSoft" Color="#3A1D12"/>
                <!-- Алиасы старых ключей (те же значения, что у токенов) -->
                <SolidColorBrush x:Key="BgBaseBrush" Color="#1E0E13"/>
                <SolidColorBrush x:Key="BgPanelBrush" Color="#2A1218"/>
                <SolidColorBrush x:Key="BgElevatedBrush" Color="#3A1A22"/>
                <SolidColorBrush x:Key="BgInputBrush" Color="#231015"/>
                <SolidColorBrush x:Key="BorderSubtleBrush" Color="#4A2530"/>
                <SolidColorBrush x:Key="BorderStrongBrush" Color="#6A3644"/>
                <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7E9EC"/>
                <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C9A6AF"/>
                <SolidColorBrush x:Key="TextMutedBrush" Color="#9C7B85"/>
                <SolidColorBrush x:Key="AccentBrush" Color="#F08AA0"/>
                <SolidColorBrush x:Key="AccentHoverBrush" Color="#F59DB0"/>
                <SolidColorBrush x:Key="AccentPressBrush" Color="#F7A8B8"/>
                <SolidColorBrush x:Key="AccentInkBrush" Color="#2A1218"/>
                <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80"/>
                <SolidColorBrush x:Key="DangerBrush" Color="#FB923C"/>
                <SolidColorBrush x:Key="RowHoverBrush" Color="#33161D"/>
                <SolidColorBrush x:Key="RowSelectedBrush" Color="#3A1A22"/>
                <!-- Свинка: цвета иллюстраций. Line/Detail — линии поверх фона (в тёмной теме светлые) -->
                <SolidColorBrush x:Key="Pig.Ink" Color="#3A1420"/>
                <SolidColorBrush x:Key="Pig.Body" Color="#F7A8B8"/>
                <SolidColorBrush x:Key="Pig.BodyShade" Color="#F08AA0"/>
                <SolidColorBrush x:Key="Pig.Slot" Color="#7A2338"/>
                <SolidColorBrush x:Key="Pig.Cork" Color="#C8925A"/>
                <SolidColorBrush x:Key="Pig.Line" Color="#F7A8B8"/>
                <SolidColorBrush x:Key="Pig.Detail" Color="#F08AA0"/>
                <!-- Акцент Fluent: фокус, выделение -->
                <Color x:Key="SystemAccentColor">#F08AA0</Color>
                <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F08AA0"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Шрифты: IBM Plex Sans (UI), IBM Plex Mono (данные), Unbounded (заголовки).
                 TTF Plex/Unbounded пока не в репозитории — цепочка падает на Geist, затем Inter. -->
            <FontFamily x:Key="Font.Ui">avares://FileManagerClient/Assets/Fonts#IBM Plex Sans, avares://FileManagerClient/Assets/Fonts#Geist, Inter</FontFamily>
            <FontFamily x:Key="Font.Mono">avares://FileManagerClient/Assets/Fonts#IBM Plex Mono, avares://FileManagerClient/Assets/Fonts#Geist Mono, Inter</FontFamily>
            <FontFamily x:Key="Font.Display">avares://FileManagerClient/Assets/Fonts#Unbounded, avares://FileManagerClient/Assets/Fonts#Geist, Inter</FontFamily>
            <!-- Старые ключи (алиасы) -->
            <FontFamily x:Key="FontUi">avares://FileManagerClient/Assets/Fonts#IBM Plex Sans, avares://FileManagerClient/Assets/Fonts#Geist, Inter</FontFamily>
            <FontFamily x:Key="FontMono">avares://FileManagerClient/Assets/Fonts#IBM Plex Mono, avares://FileManagerClient/Assets/Fonts#Geist Mono, Inter</FontFamily>

            <!-- Сетка: радиусы 8 / 12 / 16 -->
            <CornerRadius x:Key="Radius.Control">8</CornerRadius>
            <CornerRadius x:Key="Radius.Card">12</CornerRadius>
            <CornerRadius x:Key="Radius.Dialog">16</CornerRadius>

            <!-- Иконки: единая толщина, сетка 16 -->
            <StreamGeometry x:Key="IconFolder">M3.25 3h3.02c.48 0 .936.218 1.234.592l.708.888h4.528c1.036 0 1.875.84 1.875 1.875v5.65c0 1.036-.84 1.875-1.875 1.875H3.25A1.875 1.875 0 0 1 1.375 12V4.875C1.375 3.84 2.215 3 3.25 3z</StreamGeometry>
            <StreamGeometry x:Key="IconDoc">M4.5 2h3.75L12 5.75V12.5A1.5 1.5 0 0 1 10.5 14h-6A1.5 1.5 0 0 1 3 12.5v-9A1.5 1.5 0 0 1 4.5 2zm3.9 1.35v2.4h2.4l-2.4-2.4z</StreamGeometry>
            <StreamGeometry x:Key="IconUp">M8 2.25 12.25 7h-2.6v6.25H6.35V7H3.75z</StreamGeometry>
            <StreamGeometry x:Key="IconUpload">M8 1.75 11.75 5.9H9.6V10H6.4V5.9H4.25zM3 11.5h10V13H3z</StreamGeometry>
            <StreamGeometry x:Key="IconDownload">M8 14.25 4.25 10.1H6.4V6h3.2v4.1h2.15zM3 12.5h10V14H3z</StreamGeometry>
            <StreamGeometry x:Key="IconPlus">M7.25 2h1.5v5.25H14v1.5H8.75V14h-1.5V8.75H2v-1.5h5.25z</StreamGeometry>
            <StreamGeometry x:Key="IconSync">M8 1.25 4.5 5.5H7v3h2v-3h2.5zM8 14.75 11.5 10.5H9v-3H7v3H4.5z</StreamGeometry>
            <StreamGeometry x:Key="IconPencil">M11.3 1.7l3 3L6.6 12.4l-4 .9.9-4z</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M6 1.5h4l.4 1H14v1.5H2V2.5h3.6zM3.8 5.75h8.4l-.63 7.5a1.6 1.6 0 0 1-1.59 1.5H6.02a1.6 1.6 0 0 1-1.59-1.5z</StreamGeometry>
            <StreamGeometry x:Key="IconFolderBig">M4 5h3.6l1.7 2.1h5.2c1.1 0 2 .9 2 2v6.4c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2z</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M2 3.25h5.25v1.5H2z M9.25 3.25H14v1.5H9.25z M7.5 2.5h1.5v3H7.5z M2 7.25h3.25v1.5H2z M7.25 7.25H14v1.5H7.25z M5.5 6.5H7v3H5.5z M2 11.25h6.25v1.5H2z M10.25 11.25H14v1.5h-3.75z M8.5 10.5H10v3H8.5z</StreamGeometry>
            <StreamGeometry x:Key="IconSun">M8 4.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zM7.25 0.75h1.5v2h-1.5zM7.25 13.25h1.5v2h-1.5zM0.75 7.25h2v1.5h-2zM13.25 7.25h2v1.5h-2zM2.7 3.76l1.06-1.06 1.41 1.41-1.06 1.06zM10.83 11.89l1.06-1.06 1.41 1.41-1.06 1.06zM3.76 13.3l-1.06-1.06 1.41-1.41 1.06 1.06zM11.89 5.17l-1.06-1.06 1.41-1.41 1.06 1.06z</StreamGeometry>
            <StreamGeometry x:Key="IconMoon">M13.5 9.6A6 6 0 0 1 6.4 2.5a6 6 0 1 0 7.1 7.1z</StreamGeometry>
            <StreamGeometry x:Key="IconDisconnect">M7.25 1.5h1.5v6h-1.5z M12.3 4.2 11.24 5.26a4.25 4.25 0 1 1-6.48 0L3.7 4.2a5.75 5.75 0 1 0 8.6 0z</StreamGeometry>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://FileManagerClient/Controls/PigStyles.axaml"/>

        <!-- Базовые стили -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Bg}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>

        <!-- Типографика: h1 28 Unbounded 700, h2 20 Unbounded 500, тело 15, caption 13, mono 14 -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Карточки и диалоги -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.dialog">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- Кнопки: переходы 150 мс на подложке шаблона (там Fluent ставит hover/pressed) -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- Фокус с клавиатуры: контур акцентом -->
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentStrong}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
        </Style>

        <!-- Текстовая кнопка с рамкой -->
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        </Style>
        <Style Selector="Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <!-- Без рамки: icon / ghost -->
        <Style Selector="Button.icon, Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
        <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <!-- Кнопка тулбара: 44×44, иконка 20 -->
        <Style Selector="Button.toolbar">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.toolbar PathIcon">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        </Style>
        <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <!-- Опасное действие: цвет ошибки; рядом с icon/tool остаётся их фон -->
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}"/>
        </Style>
        <Style Selector="Button.danger.solid">
            <Setter Property="Background" Value="{DynamicResource Brush.Error}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger.solid:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.Error}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.OnAccent}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.RowHover}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="SeparatorBrush" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource Brush.RowHover}"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{DynamicResource Brush.SurfaceAlt}"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="MinHeight" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource Brush.RowHover}"/>
        </Style>
    </Application.Styles>
</Application>
