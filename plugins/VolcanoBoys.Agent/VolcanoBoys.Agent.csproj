<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Makes the plugin carry its dependencies and a .deps.json that the host reads. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\FileManager.Plugins.Sdk\FileManager.Plugins.Sdk.csproj" />
        <!-- Client of the model API (OpenAI-compatible endpoint of the provider). -->
        <PackageReference Include="OpenAI" Version="2.14.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
